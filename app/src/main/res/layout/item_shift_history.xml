<?xml version="1.0" encoding="utf-8"?>
<!-- Layout de ítem para RecyclerView "Historial de Turnos" (Detalle de Asistencia) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="8dp">

    <!-- Viñeta / Indicador de Evento de Turno -->
    <ImageView
        android:id="@+id/ivShiftBullet"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null"
        app:srcCompat="@drawable/ic_bullet_point"
        app:tint="@color/cafe_profundo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Nombre/Tipo de Evento de Turno (Entrada/Salida) -->
        <TextView
            android:id="@+id/tvShiftType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textColor="@color/cafe_profundo"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Entrada" />

        <!-- Fecha del evento -->
        <TextView
            android:id="@+id/tvShiftDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/chocolate"
            android:textSize="12sp"
            tools:text="18 de nov. de 2026" />
    </LinearLayout>

    <!-- Hora del evento (ej: 08:00 a.m.) -->
    <TextView
        android:id="@+id/tvShiftTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:textColor="@color/cafe_profundo"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="08:00 a.m." />

</LinearLayout>
