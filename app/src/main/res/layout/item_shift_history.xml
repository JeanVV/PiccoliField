<?xml version="1.0" encoding="utf-8"?>
<!-- Layout de ítem para RecyclerView "Historial de Turnos" (Detalle de Asistencia) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_normal"
    android:paddingVertical="@dimen/spacing_small">

    <!-- Viñeta / Indicador de Evento de Turno -->
    <ImageView
        android:id="@+id/ivShiftBullet"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_bullet_point"
        app:tint="@color/cafe_profundo" />

    <!-- Nombre/Tipo de Evento de Turno (BD: turno_historial.tipo_evento -> "Turno-in", "Salida", "Licencia") -->
    <TextView
        android:id="@+id/tvShiftType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:textAppearance="@style/TextAppearance.Piccoli.BodyPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvShiftTime"
        app:layout_constraintStart_toEndOf="@+id/ivShiftBullet"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Turno-in" />

    <!-- Hora del evento (BD: turno_historial.hora_evento -> "08:00 a.m.") -->
    <TextView
        android:id="@+id/tvShiftTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Piccoli.BodySecondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="08:00 a.m." />

</androidx.constraintlayout.widget.ConstraintLayout>
