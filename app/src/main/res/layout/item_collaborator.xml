<?xml version="1.0" encoding="utf-8"?>
<!-- Layout de ítem para lista de Colaboradores (activity_collaborators.xml) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCollaboratorItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_normal"
    android:layout_marginVertical="@dimen/spacing_micro"
    app:cardBackgroundColor="@color/marfil_suave"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:strokeColor="@color/stroke_color"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_medium">

        <!-- Foto circular de perfil (BD: colaborador.foto_url) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCollaboratorPhoto"
            android:layout_width="@dimen/avatar_size_medium"
            android:layout_height="@dimen/avatar_size_medium"
            android:contentDescription="@string/cd_user_avatar"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Piccoli.Circular"
            app:srcCompat="@drawable/ic_avatar_placeholder" />

        <!-- Nombre del Colaborador (BD: colaborador.nombre) -->
        <TextView
            android:id="@+id/tvCollaboratorName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_marginEnd="@dimen/spacing_micro"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Piccoli.BodyPrimary"
            app:layout_constraintEnd_toStartOf="@+id/ivWarningIcon"
            app:layout_constraintStart_toEndOf="@+id/ivCollaboratorPhoto"
            app:layout_constraintTop_toTopOf="@+id/ivCollaboratorPhoto"
            tools:text="Luís Rojas" />

        <!-- Ícono de Alerta/Advertencia opcional (BD: incidencia.requiere_atencion) -->
        <ImageView
            android:id="@+id/ivWarningIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="@dimen/spacing_small"
            android:contentDescription="@null"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/tvCollaboratorName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvCollaboratorName"
            app:srcCompat="@drawable/ic_warning_alert"
            tools:visibility="visible" />

        <!-- Ícono de Ubicación -->
        <ImageView
            android:id="@+id/ivLocationIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/cd_location_icon"
            app:layout_constraintStart_toStartOf="@+id/tvCollaboratorName"
            app:layout_constraintTop_toBottomOf="@+id/tvCollaboratorName"
            app:srcCompat="@drawable/ic_location_pin"
            app:tint="@color/chocolate" />

        <!-- Ubicación asignada o Sede (BD: sede.nombre_comercial) -->
        <TextView
            android:id="@+id/tvCollaboratorLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="@dimen/spacing_small"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Piccoli.BodySecondary"
            app:layout_constraintBottom_toBottomOf="@+id/ivLocationIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivLocationIcon"
            app:layout_constraintTop_toTopOf="@+id/ivLocationIcon"
            tools:text="Licorería El Buen Sabor" />

        <!-- Chip/Badge de Estado (BD: estado_asistencia -> A tiempo / Tardanza / Falta / Permiso) -->
        <TextView
            android:id="@+id/tvCollaboratorStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/badge_height"
            android:layout_marginTop="@dimen/spacing_small"
            android:background="@drawable/bg_badge_on_time"
            android:gravity="center"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:textAppearance="@style/TextAppearance.Piccoli.Badge"
            android:textColor="@color/status_on_time_text"
            app:layout_constraintStart_toStartOf="@+id/ivLocationIcon"
            app:layout_constraintTop_toBottomOf="@+id/tvCollaboratorLocation"
            tools:text="A tiempo" />

        <!-- Hora registrada de entrada (BD: asistencia.hora_entrada) -->
        <TextView
            android:id="@+id/tvCollaboratorTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:textAppearance="@style/TextAppearance.Piccoli.Caption"
            app:layout_constraintBottom_toBottomOf="@+id/tvCollaboratorStatusBadge"
            app:layout_constraintStart_toEndOf="@+id/tvCollaboratorStatusBadge"
            app:layout_constraintTop_toTopOf="@+id/tvCollaboratorStatusBadge"
            tools:text="- 08:02 a.m." />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
