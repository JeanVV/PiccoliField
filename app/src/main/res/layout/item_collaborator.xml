<?xml version="1.0" encoding="utf-8"?>
<!-- Layout de ítem para lista de Colaboradores -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCollaboratorItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E5D5C0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Foto circular de perfil centrada verticalmente -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCollaboratorPhoto"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/cd_user_avatar"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
            app:srcCompat="@drawable/ic_avatar_placeholder" />

        <!-- Contenedor del texto del colaborador centrado verticalmente con la imagen -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivCollaboratorPhoto"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Fila Superior: Nombre y Alerta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCollaboratorName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:maxLines="1"
                    android:textColor="@color/cafe_profundo"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Luís Rojas" />

                <ImageView
                    android:id="@+id/ivWarningIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_warning_alert"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Fila Media: Ícono de Ubicación y Nombre de Sede -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivLocationIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/cd_location_icon"
                    app:srcCompat="@drawable/ic_location_pin"
                    app:tint="@color/chocolate" />

                <TextView
                    android:id="@+id/tvCollaboratorLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/chocolate"
                    android:textSize="13sp"
                    tools:text="Licorería El Buen Sabor" />
            </LinearLayout>

            <!-- Fila Inferior: Badge de Estado y Hora -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCollaboratorStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_badge_on_time"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/status_on_time_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="A tiempo" />

                <TextView
                    android:id="@+id/tvCollaboratorTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/color_text_muted"
                    android:textSize="11sp"
                    tools:text="- 08:02 a.m." />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
