<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/marfil_suave"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#E5D5C0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Circular Badge Avatar a la Izquierda (ej: 12, 5, 14, etc.) -->
        <FrameLayout
            android:id="@+id/frameBadgeIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_stat_icon_circle"
            android:backgroundTint="@color/cafe_profundo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvBadgeNumero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="serif"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="12" />
        </FrameLayout>

        <!-- Flecha Chevron a la Derecha -->
        <ImageView
            android:id="@+id/ivChevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_forward"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/dorado_premium" />

        <!-- Nombre del Local -->
        <TextView
            android:id="@+id/tvNombrePdv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="serif"
            android:textColor="@color/cafe_profundo"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/ivChevron"
            app:layout_constraintStart_toEndOf="@+id/frameBadgeIcon"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Licorería El Buen Sabor" />

        <!-- Dirección -->
        <TextView
            android:id="@+id/tvDireccionPdv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/color_text_muted"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@+id/ivChevron"
            app:layout_constraintStart_toStartOf="@+id/tvNombrePdv"
            app:layout_constraintTop_toBottomOf="@+id/tvNombrePdv"
            tools:text="Av. Principal 123, Lima" />

        <!-- Número de Pedido -->
        <TextView
            android:id="@+id/tvNumeroPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/cafe_profundo"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvNombrePdv"
            app:layout_constraintTop_toBottomOf="@+id/tvDireccionPdv"
            tools:text="Nº Pedido: 0245" />

        <!-- Badge de Estado del Despacho (En preparación, En camino, Pendiente) -->
        <TextView
            android:id="@+id/tvEstadoDespacho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_rounded"
            android:backgroundTint="#FDEBD0"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textColor="#B9783E"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="En preparación" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>