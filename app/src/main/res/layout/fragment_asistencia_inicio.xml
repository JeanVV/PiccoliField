<?xml version="1.0" encoding="utf-8"?>
<!-- Fragmento 1: Inicio de Asistencias (fragment_asistencia_inicio.xml) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/asistenciaHomeRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    tools:context=".ui.asistencia.AsistenciaHomeFragment">

    <!-- ScrollView para acomodar todos los elementos suavemente -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="90dp">

            <!-- 1. Cabecera Header (Estilo Puntos Despacho) -->
            <RelativeLayout
                android:id="@+id/toolbarHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <View
                    android:id="@+id/vHeaderSpacer"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/tvToolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="serif"
                    android:text="@string/title_inicio_asistencias"
                    android:textColor="@color/cafe_profundo"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnNotification"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/cd_notification"
                    android:focusable="true"
                    android:src="@drawable/ic_notification_bell" />
            </RelativeLayout>

            <!-- BANNER DE JUSTIFICACIONES PENDIENTES DE REVISIÓN -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPendingJustificationsBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFF3E0"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#FFB74D"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stat_icon_circle"
                        android:backgroundTint="#FFE0B2"
                        android:padding="6dp"
                        android:src="@drawable/ic_warning_alert"
                        app:tint="#E65100"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPendingJustificationsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Justificaciones Pendientes"
                            android:textColor="#E65100"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPendingJustificationsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hay colaboradores con faltas por revisar."
                            android:textColor="@color/chocolate"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFiltrarPendientes"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Ver"
                        android:textColor="#E65100"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Buscador y Botón de Filtros (Estilo Puntos Despacho) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Buscador -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSearchContainer"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="23dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5D5C0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:id="@+id/ivSearchIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_search"
                            app:tint="@color/chocolate" />

                        <EditText
                            android:id="@+id/etSearchCollaborator"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:autofillHints="name"
                            android:background="@null"
                            android:hint="@string/hint_search_collaborators"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:textColor="@color/cafe_profundo"
                            android:textColorHint="@color/color_text_muted"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Botón Filtros -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnFiltrosContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="23dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5D5C0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:id="@+id/btnFilter"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/cd_filter"
                            android:src="@drawable/ic_filter"
                            app:tint="@color/cafe_profundo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Filtros"
                            android:textColor="@color/cafe_profundo"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 3. Card Resumen del Día: "Asistencias de Hoy" (Hero Banner Estilo Puntos Despacho) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTodaySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#F5E8D0"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#E3CEAA"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvSummaryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="@string/label_asistencias_hoy"
                        android:textColor="@color/cafe_profundo"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Progreso Circular -->
                    <ProgressBar
                        android:id="@+id/pbAttendancePercentage"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginTop="16dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="84"
                        android:progressDrawable="@drawable/bg_circular_progress"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvSummaryTitle" />

                    <!-- Detalle de Porcentaje -->
                    <LinearLayout
                        android:id="@+id/layoutProgressDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="@+id/pbAttendancePercentage"
                        app:layout_constraintEnd_toEndOf="@+id/pbAttendancePercentage"
                        app:layout_constraintStart_toStartOf="@+id/pbAttendancePercentage"
                        app:layout_constraintTop_toTopOf="@+id/pbAttendancePercentage">

                        <TextView
                            android:id="@+id/tvAttendancePercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:textColor="@color/cafe_profundo"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            tools:text="84%" />

                        <TextView
                            android:id="@+id/tvPresentesLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_presentes"
                            android:textColor="@color/chocolate"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvPresentesFraction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/cafe_profundo"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="76/90" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Fila de Métricas: "A tiempo" y "Tardanzas" -->
            <LinearLayout
                android:id="@+id/layoutMetricsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Card 1: A tiempo -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOnTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#F5E8D0"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E3CEAA"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvOnTimeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_a_tiempo"
                            android:textColor="@color/cafe_profundo"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOnTimeCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="serif"
                            android:textColor="@color/cafe_profundo"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="(64)" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Tardanzas -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#F5E8D0"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E3CEAA"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvLateTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_tardanzas"
                            android:textColor="@color/cafe_profundo"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLateCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="serif"
                            android:textColor="@color/cafe_profundo"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="(12)" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 5. ACCESOS RÁPIDOS A MAPA Y COLABORADORES -->
            <TextView
                android:id="@+id/tvQuickAccessTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="serif"
                android:text="Accesos Rápidos"
                android:textColor="@color/cafe_profundo"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutQuickAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:orientation="horizontal">

                <!-- Card para ir al Mapa -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGoToMap"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/cafe_profundo"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_nav_map"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Ver Mapa"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card para ir a Colaboradores -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGoToCollaborators"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5D5C0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_nav_people"
                            app:tint="@color/cafe_profundo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Colaboradores"
                            android:textColor="@color/cafe_profundo"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 6. Título de Sección: "Personal Reciente" -->
            <TextView
                android:id="@+id/tvRecentPersonnelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="serif"
                android:text="@string/label_personal_reciente"
                android:textColor="@color/cafe_profundo"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Estado Vacío -->
            <LinearLayout
                android:id="@+id/layoutEmptyRecentState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_empty_data" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/empty_recent_personnel"
                    android:textColor="@color/chocolate"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- RecyclerView Personal Reciente -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentPersonnel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_recent_personnel" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
