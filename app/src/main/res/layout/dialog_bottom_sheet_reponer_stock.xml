<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/color_fondo"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reponer Stock de Producto"
        android:textColor="@color/cafe_profundo"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Info del Producto Encontrado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/ivProductoReposicion"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_avatar_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreProductoReposicion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Producto"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEanReposicion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EAN: ---"
                android:textColor="#757575"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvStockActualReposicion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock actual: 0 unds"
                android:textColor="@color/chocolate"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cantidad a reponer:"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etCantidadReposicion"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_search_box"
        android:inputType="number"
        android:text="10"
        android:paddingHorizontal="12dp"
        android:textColor="#333333"
        android:textSize="16sp"
        android:autofillHints="quantity"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Observación / Guía de Remisión:"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etObservacionReposicion"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bg_search_box"
        android:gravity="top|start"
        android:hint="Ej. Lote recibido según Guía GR-00412"
        android:padding="12dp"
        android:textColor="#333333"
        android:textSize="14sp"
        android:inputType="textMultiLine"
        android:autofillHints="description"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmarReposicion"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Confirmar Reposición"
        app:backgroundTint="#388E3C"
        android:textColor="@android:color/white"
        app:cornerRadius="12dp" />

</LinearLayout>