<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/marfil_suave"
    android:fillViewport="true"
    tools:context=".ui.asistencias.AsistenciasFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TOOLBAR DE NAVEGACIÓN CON FLECHA ATRÁS -->
        <RelativeLayout
            android:id="@+id/toolbarHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cd_back"
                android:focusable="true"
                android:src="@drawable/ic_back_arrow"
                app:tint="@color/cafe_profundo" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="serif"
                android:text="Asistencia Diaria"
                android:textColor="@color/cafe_profundo"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- HEADER CON NOMBRE Y ROL DE COLABORADOR -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/cafe_profundo"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_stat_icon_circle"
                    android:backgroundTint="@color/dorado_premium"
                    android:padding="12dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/cafe_profundo"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreColaborador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hola, Colaborador"
                        android:textColor="@color/marfil_suave"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRolColaborador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Rol: PROMOTOR"
                        android:textColor="@color/beige_licor"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_check_circle_green"
                    tools:ignore="ContentDescription" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- SECCIÓN 1: MARCAR ASISTENCIA DIARIA -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/stroke_color"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_stat_icon_circle"
                        android:backgroundTint="#F3E4C7"
                        android:padding="8dp"
                        android:src="@drawable/ic_asistencias"
                        app:tint="@color/cafe_profundo"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Marcado de Asistencia"
                            android:textColor="@color/cafe_profundo"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvFechaHoy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hoy, -- de -- de ----"
                            android:textColor="@color/chocolate"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- TARJETA DE GEOFENCE Y DISTANCIA A LA SEDE -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGeofenceInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardBackgroundColor="#F8F4EC"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/stroke_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_location_pin"
                            app:tint="@color/cafe_profundo"
                            tools:ignore="ContentDescription" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sede Principal Chiclayo"
                                android:textColor="@color/cafe_profundo"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDistanciaSede"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Distancia: 28 m (Zona Lima/Perú)"
                                android:textColor="@color/chocolate"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvGeofenceBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_on_time"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="EN RANGO"
                            android:textColor="@color/status_on_time_text"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BOTÓN PROMINENTE PARA ABRIR PANTALLA DE MONITOREO / MAPA -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerMapaMonitoreo"
                    style="@style/Widget.Piccoli.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="Ver Monitoreo en Mapa"
                    android:textColor="@color/cafe_profundo"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_location_pin"
                    app:iconTint="@color/cafe_profundo"
                    app:strokeColor="@color/cafe_profundo"
                    app:strokeWidth="1dp" />

                <!-- RELOJ VIVO Y ESTADO ACTUAL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_badge_permission"
                    android:backgroundTint="#FDF8F0"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvHoraReloj"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--:--:--"
                        android:textColor="@color/cafe_profundo"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEstadoHoy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Estado: Pendiente de marcado"
                        android:textColor="@color/caramelo"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- BOTONES DE MARCADOR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMarcarEntrada"
                        style="@style/Widget.Piccoli.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="Entrada"
                        app:icon="@drawable/ic_clock"
                        app:iconTint="@color/marfil_suave" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMarcarRefrigerio"
                        style="@style/Widget.Piccoli.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:text="Refrigerio"
                        app:icon="@drawable/ic_clock"
                        app:iconTint="@color/cafe_profundo" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMarcarSalida"
                        style="@style/Widget.Piccoli.Button.Accent"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Salida"
                        app:icon="@drawable/ic_clock"
                        app:iconTint="@color/cafe_profundo" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- SECCIÓN 2: BOTÓN Y CARD PARA JUSTIFICAR FALTA (LIMPIO Y ORDENADO) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/stroke_color"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_stat_icon_circle"
                        android:backgroundTint="#FDE8E8"
                        android:padding="8dp"
                        android:src="@drawable/ic_warning_alert"
                        app:tint="#B91C1C"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Justificar Falta o Tardanza"
                            android:textColor="@color/cafe_profundo"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Registra tu justificación con motivo y comprobante."
                            android:textColor="@color/color_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- BOTÓN QUE ABRE EL BOTTOM SHEET DIALOG DE JUSTIFICACIÓN -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAbrirJustificacionBS"
                    style="@style/Widget.Piccoli.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="Registrar Justificación"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_warning_alert"
                    app:iconTint="@color/marfil_suave" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- SECCIÓN 3: ESTADO / HISTORIAL DE JUSTIFICACIÓN -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEstadoJustificacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFF8E7"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/dorado_premium"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Última Justificación Enviada"
                    android:textColor="@color/cafe_profundo"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMotivoResumen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Motivo: Salud / Cita Médica"
                    android:textColor="@color/chocolate"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDetalleResumen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Detalle: Se adjuntará el descanso médico correspondiente."
                    android:textColor="@color/color_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvEstadoJustificacionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_badge_permission"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="ENVIADA - PENDIENTE DE REVISIÓN"
                    android:textColor="@color/status_permission_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
