<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/stroke_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Icono de advertencia circular -->
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_stat_icon_circle"
            android:backgroundTint="#FDE8E8"
            android:padding="14dp"
            android:src="@drawable/ic_location_pin"
            app:tint="#B91C1C"
            tools:ignore="ContentDescription" />

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="serif"
            android:text="Fuera del Rango"
            android:textColor="@color/cafe_profundo"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Mensaje con distancia -->
        <TextView
            android:id="@+id/tvMensajeDistancia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/chocolate"
            android:textSize="14sp"
            tools:text="Te encuentras a 250 m de la sede. Debes estar dentro del rango (100 m) para registrar asistencia." />

        <!-- Botón Entendido -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEntendido"
            style="@style/Widget.Piccoli.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="Entendido"
            app:cornerRadius="14dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
