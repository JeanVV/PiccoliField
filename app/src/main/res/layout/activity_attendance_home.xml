<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 1: Inicio de Asistencias (activity_attendance_home.xml) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/attendanceHomeRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema_vainilla"
    tools:context=".AsistenciaInicioActivity">

    <!-- Header Toolbar Superior -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_normal"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/title_inicio_asistencias"
            android:textAppearance="@style/TextAppearance.Piccoli.ToolbarTitle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnNotification"
            app:layout_constraintStart_toEndOf="@+id/vHeaderSpacer"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/vHeaderSpacer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnNotification"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_notification"
            android:src="@drawable/ic_notification_bell"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Contenido con Scroll -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Barra de Búsqueda de Colaboradores -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSearchContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/search_bar_height"
                android:layout_marginHorizontal="@dimen/spacing_normal"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_medium"
                app:cardBackgroundColor="@color/marfil_suave"
                app:cardCornerRadius="24dp"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="@color/stroke_color"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/ivSearchIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_search_icon" />

                    <EditText
                        android:id="@+id/etSearchCollaborator"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:layout_marginEnd="@dimen/spacing_small"
                        android:autofillHints="name"
                        android:background="@null"
                        android:hint="@string/hint_search_collaborators"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:textAppearance="@style/TextAppearance.Piccoli.BodySecondary"
                        android:textColorHint="@color/color_text_muted"
                        app:layout_constraintEnd_toStartOf="@+id/btnFilter"
                        app:layout_constraintStart_toEndOf="@+id/ivSearchIcon" />

                    <ImageButton
                        android:id="@+id/btnFilter"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_filter"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_filter_list" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card Resumen del Día: "Asistencias de Hoy" -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTodaySummary"
                style="@style/Widget.Piccoli.Card.Marfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_normal"
                android:layout_marginBottom="@dimen/spacing_medium">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_normal">

                    <TextView
                        android:id="@+id/tvSummaryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_asistencias_hoy"
                        android:textAppearance="@style/TextAppearance.Piccoli.CardTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Progreso Circular (BD: porcentaje_asistencia) -->
                    <ProgressBar
                        android:id="@+id/pbAttendancePercentage"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="@dimen/progress_ring_size"
                        android:layout_height="@dimen/progress_ring_size"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="84"
                        android:progressDrawable="@drawable/bg_circular_progress"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvSummaryTitle" />

                    <!-- Contenido Central del Progreso (Porcentaje y Fracción) -->
                    <LinearLayout
                        android:id="@+id/layoutProgressDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="@+id/pbAttendancePercentage"
                        app:layout_constraintEnd_toEndOf="@+id/pbAttendancePercentage"
                        app:layout_constraintStart_toStartOf="@+id/pbAttendancePercentage"
                        app:layout_constraintTop_toTopOf="@+id/pbAttendancePercentage">

                        <!-- BD: @{viewModel.attendancePercentageText} ej. "84%" -->
                        <TextView
                            android:id="@+id/tvAttendancePercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Piccoli.DisplayNumber"
                            tools:text="84%" />

                        <TextView
                            android:id="@+id/tvPresentesLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_presentes"
                            android:textAppearance="@style/TextAppearance.Piccoli.Caption" />

                        <!-- BD: @{viewModel.presentFractionText} ej. "76/90" -->
                        <TextView
                            android:id="@+id/tvPresentesFraction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Piccoli.BodySecondary"
                            android:textStyle="bold"
                            tools:text="76/90" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Dos Cards Horizontales: "A tiempo" y "Tardanzas" -->
            <LinearLayout
                android:id="@+id/layoutMetricsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_normal"
                android:layout_marginBottom="@dimen/spacing_normal"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Card 1: A tiempo (BD: colaboradores_a_tiempo_count) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOnTime"
                    style="@style/Widget.Piccoli.Card.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_medium">

                        <TextView
                            android:id="@+id/tvOnTimeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_a_tiempo"
                            android:textAppearance="@style/TextAppearance.Piccoli.CardTitle" />

                        <!-- BD: @{viewModel.onTimeCount} ej. "(64)" -->
                        <TextView
                            android:id="@+id/tvOnTimeCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.Piccoli.CardTitle"
                            tools:text="(64)" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Tardanzas (BD: colaboradores_tardanza_count) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLate"
                    style="@style/Widget.Piccoli.Card.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_medium">

                        <TextView
                            android:id="@+id/tvLateTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_tardanzas"
                            android:textAppearance="@style/TextAppearance.Piccoli.CardTitle" />

                        <!-- BD: @{viewModel.lateCount} ej. "(12)" -->
                        <TextView
                            android:id="@+id/tvLateCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.Piccoli.CardTitle"
                            tools:text="(12)" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ========================================== -->
            <!-- ACCESOS RÁPIDOS (Reemplaza la BottomNav)   -->
            <!-- ========================================== -->
            <TextView
                android:id="@+id/tvQuickAccessTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_normal"
                android:layout_marginTop="@dimen/spacing_normal"
                android:layout_marginBottom="@dimen/spacing_small"
                android:text="Accesos Rápidos"
                android:textAppearance="@style/TextAppearance.Piccoli.SectionHeader" />

            <LinearLayout
                android:id="@+id/layoutQuickAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_normal"
                android:layout_marginBottom="@dimen/spacing_normal"
                android:orientation="horizontal">

                <!-- Card para ir al Mapa -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGoToMap"
                    style="@style/Widget.Piccoli.Card.Primary"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_medium">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_nav_map"
                            app:tint="@color/marfil_suave" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Ver Mapa"
                            android:textAppearance="@style/TextAppearance.Piccoli.BodyPrimary"
                            android:textColor="@color/marfil_suave" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card para ir a Colaboradores -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGoToCollaborators"
                    style="@style/Widget.Piccoli.Card.Marfil"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_medium">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_nav_people"
                            app:tint="@color/cafe_profundo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Colaboradores"
                            android:textAppearance="@style/TextAppearance.Piccoli.BodyPrimary"
                            android:textColor="@color/cafe_profundo" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
            <!-- ========================================== -->

            <!-- Título de Sección: "Personal Reciente" -->
            <TextView
                android:id="@+id/tvRecentPersonnelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_normal"
                android:layout_marginBottom="@dimen/spacing_small"
                android:text="@string/label_personal_reciente"
                android:textAppearance="@style/TextAppearance.Piccoli.SectionHeader" />

            <!-- Estado Vacío (Empty State cuando no existen registros en la BD) -->
            <LinearLayout
                android:id="@+id/layoutEmptyRecentState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_empty_data" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/empty_recent_personnel"
                    android:textAppearance="@style/TextAppearance.Piccoli.BodySecondary" />

            </LinearLayout>

            <!-- RecyclerView Personal Reciente -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentPersonnel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="@dimen/spacing_medium"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_recent_personnel" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Barra de Navegación Inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/marfil_suave"
        app:itemIconTint="@color/cafe_profundo"
        app:itemTextColor="@color/cafe_profundo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>