<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/color_fondo"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_reasignar_impulsador"
        android:textColor="@color/cafe_profundo"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_seleccione_impulsador"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spImpulsadores"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_search_box"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/pbLoadingImpulsadores"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_motivo_reasignacion"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etMotivo"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/bg_search_box"
        android:gravity="top|start"
        android:hint="@string/hint_motivo"
        android:padding="12dp"
        android:textColor="#333333"
        android:textSize="14sp"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmarReasignar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/btn_confirmar_reasignacion"
        app:backgroundTint="@color/cafe_profundo"
        android:textColor="@android:color/white"
        app:cornerRadius="12dp" />

</LinearLayout>