<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/color_fondo"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleccionar Producto"
        android:textColor="@color/cafe_profundo"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etBuscarCatalogo"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_search_rounded"
        android:drawableStart="@drawable/ic_search"
        android:drawableTint="@color/chocolate"
        android:drawablePadding="10dp"
        android:hint="Buscar por nombre o EAN..."
        android:paddingHorizontal="14dp"
        android:textColor="#333333"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/pbLoadingCatalogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCatalogoProductos"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        tools:listitem="@layout/item_producto_supervision"
        tools:itemCount="4" />

</LinearLayout>