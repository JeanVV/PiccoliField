<?xml version="1.0" encoding="utf-8"?>
<!-- Fragmento: Monitoreo en Mapa (fragment_mapa.xml) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mapaRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    tools:context=".ui.asistencia.MapaFragment">

    <!-- Header Toolbar Superior -->
    <RelativeLayout
        android:id="@+id/toolbarHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="serif"
            android:text="@string/title_monitoreo_mapa"
            android:textColor="@color/cafe_profundo"
            android:textSize="20sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Control Selector de Vista: Toggle Pill ("Mapa" | "Lista") -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardToggleViewSelector"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        app:cardBackgroundColor="#F3E4C7"
        app:cardCornerRadius="23dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarHeader"
        app:strokeColor="#E3CEAA"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="3dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleMap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_mapa"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/cafe_profundo"
                app:cornerRadius="20dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleList"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_lista"
                android:textAllCaps="false"
                android:textColor="@color/cafe_profundo"
                android:textSize="14sp"
                app:cornerRadius="20dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Indicador Flotante / Badge de Rango de Geocerca -->
    <LinearLayout
        android:id="@+id/layoutBadgeContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardToggleViewSelector">

        <TextView
            android:id="@+id/tvGeofenceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_on_time"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="EN RANGO"
            android:textColor="@color/cafe_profundo"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Contenedor del Mapa interactivo -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomSheetZoneCollaborators"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutBadgeContainer">

        <com.google.android.gms.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/cd_location_icon"
            app:backgroundTint="@color/white"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_location_pin"
            app:tint="@color/cafe_profundo" />

    </FrameLayout>

    <!-- Contenedor Alternativo para Modo Lista -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCollaboratorsList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:padding="16dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/bottomSheetZoneCollaborators"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutBadgeContainer"
        tools:listitem="@layout/item_collaborator" />

    <!-- Card Inferior (BottomSheet de Información y Acciones) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomSheetZoneCollaborators"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#F5E8D0"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#E3CEAA"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Título / Nombre de Sede -->
            <TextView
                android:id="@+id/tvSedeNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="Sede Principal Chiclayo - Piccoli Cocktail"
                android:textColor="@color/cafe_profundo"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Mensaje de Estado / Distancia -->
            <TextView
                android:id="@+id/tvStatusMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/cafe_profundo"
                android:textSize="13sp"
                tools:text="Estás dentro de la zona de asistencia. Listo para marcar." />

            <!-- Dirección -->
            <TextView
                android:id="@+id/tvDireccionAsistencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#7A6855"
                android:textSize="12sp"
                tools:text="Av. Balta 123, Chiclayo" />

            <!-- Botones de Acción "Ver detalles" y "Cómo llegar" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewDetails"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1.2"
                    android:text="@string/btn_ver_detalles"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/cafe_profundo"
                    app:cornerRadius="20dp"
                    app:elevation="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHowToGetThere"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/btn_como_llegar"
                    android:textAllCaps="false"
                    android:textColor="@color/cafe_profundo"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_location_pin"
                    app:iconTint="@color/cafe_profundo"
                    app:strokeColor="@color/cafe_profundo"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
