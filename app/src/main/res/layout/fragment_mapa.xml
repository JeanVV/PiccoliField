<?xml version="1.0" encoding="utf-8"?>
<!-- Fragmento 2: Monitoreo en Mapa (fragment_mapa.xml) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mapaRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    tools:context=".ui.asistencia.MapaFragment">

    <!-- Header Toolbar Superior (Estilo Puntos Despacho) -->
    <RelativeLayout
        android:id="@+id/toolbarHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="serif"
            android:text="@string/title_monitoreo_mapa"
            android:textColor="@color/cafe_profundo"
            android:textSize="20sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Control Selector de Vista: Toggle Pill ("Mapa" | "Lista") (Estilo Puntos Despacho) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardToggleViewSelector"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        app:cardBackgroundColor="#F3E4C7"
        app:cardCornerRadius="23dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarHeader"
        app:strokeColor="#E3CEAA"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="3dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleMap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_mapa"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/cafe_profundo"
                app:cornerRadius="20dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleList"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_lista"
                android:textAllCaps="false"
                android:textColor="@color/cafe_profundo"
                android:textSize="14sp"
                app:cornerRadius="20dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Contenedor del Mapa -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomSheetZoneCollaborators"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardToggleViewSelector" />

    <!-- Capa de Overlays Simulados sobre el Mapa -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutMapOverlays"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/mapContainer"
        app:layout_constraintEnd_toEndOf="@+id/mapContainer"
        app:layout_constraintStart_toStartOf="@+id/mapContainer"
        app:layout_constraintTop_toTopOf="@+id/mapContainer">

        <!-- Círculo de Geofencing Translucido -->
        <View
            android:id="@+id/vGeofenceCircle"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:background="@drawable/bg_geofence_ring"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Tag de Rango de Asistencia -->
        <TextView
            android:id="@+id/tvAssistanceRangeTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_badge_on_time"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/label_rango_asistencia"
            android:textColor="@color/cafe_profundo"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/cardMapMarkerTooltip"
            app:layout_constraintEnd_toEndOf="@+id/cardMapMarkerTooltip"
            app:layout_constraintStart_toStartOf="@+id/cardMapMarkerTooltip" />

        <!-- Tooltip Marker del Mapa (BD: sede.nombre) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMapMarkerTooltip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/cafe_profundo"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/vGeofenceCircle"
            app:layout_constraintEnd_toEndOf="@+id/vGeofenceCircle"
            app:layout_constraintStart_toStartOf="@+id/vGeofenceCircle"
            app:layout_constraintTop_toTopOf="@+id/vGeofenceCircle">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/tvMarkerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/marfil_suave"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Sede Los Olivos - Plaza Vea" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Pin de Ubicación Central -->
        <ImageView
            android:id="@+id/ivCenterMapPin"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:contentDescription="@null"
            app:layout_constraintEnd_toEndOf="@+id/cardMapMarkerTooltip"
            app:layout_constraintStart_toStartOf="@+id/cardMapMarkerTooltip"
            app:layout_constraintTop_toBottomOf="@+id/cardMapMarkerTooltip"
            app:srcCompat="@drawable/ic_location_pin"
            app:tint="@color/cafe_profundo" />

        <!-- Botón Flotante para Mi Ubicación -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/cd_location_icon"
            app:backgroundTint="@color/white"
            app:fabSize="mini"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ic_navigation_directions"
            app:tint="@color/cafe_profundo" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Card Inferior (BottomSheet) con Colaboradores en la Zona (Estilo Puntos Despacho) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomSheetZoneCollaborators"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="80dp"
        app:cardBackgroundColor="#F5E8D0"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#E3CEAA"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Título con Contador (BD: zona.colaboradores_count) -->
            <TextView
                android:id="@+id/tvZoneCollaboratorsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="@color/cafe_profundo"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Colaboradores en la zona (14)" />

            <!-- Lista Horizontal de Fotos Pequeñas de Colaboradores -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvZoneAvatars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="5"
                tools:listitem="@layout/item_recent_personnel" />

            <!-- Botones de Acción "Ver detalles" y "Cómo llegar" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewDetails"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1.2"
                    android:text="@string/btn_ver_detalles"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/cafe_profundo"
                    app:cornerRadius="20dp"
                    app:elevation="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHowToGetThere"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/btn_como_llegar"
                    android:textAllCaps="false"
                    android:textColor="@color/cafe_profundo"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_location_pin"
                    app:iconTint="@color/cafe_profundo"
                    app:strokeColor="@color/cafe_profundo"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
