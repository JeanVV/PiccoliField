<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/color_fondo"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reportar Incidencia"
        android:textColor="@color/cafe_profundo"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Tipo de Incidencia -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tipo de Incidencia"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spTipoIncidencia"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_spinner_rounded"
        android:popupBackground="@color/white"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Severidad -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Severidad"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spSeveridadIncidencia"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_spinner_rounded"
        android:popupBackground="@color/white"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Descripción -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripción del Inconveniente"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etDescripcionIncidencia"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@drawable/bg_search_box"
        android:gravity="top|start"
        android:hint="Describa brevemente lo sucedido..."
        android:padding="12dp"
        android:textColor="#333333"
        android:textSize="14sp"
        android:inputType="textMultiLine"
        android:autofillHints="description"
        android:layout_marginBottom="16dp" />

    <!-- Adjuntar Foto -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdjuntarFotoIncidencia"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Adjuntar Evidencia (Opcional)"
        app:icon="@drawable/ic_photos"
        app:iconTint="@color/chocolate"
        app:iconGravity="textStart"
        app:strokeColor="@color/chocolate"
        android:textColor="@color/chocolate"
        app:cornerRadius="12dp"
        android:layout_marginBottom="24dp" />

    <!-- Confirmar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEnviarIncidencia"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Enviar Reporte de Incidencia"
        app:backgroundTint="@color/color_acento"
        android:textColor="@android:color/white"
        app:cornerRadius="12dp" />

</LinearLayout>