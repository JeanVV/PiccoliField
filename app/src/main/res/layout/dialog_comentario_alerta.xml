<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/color_fondo"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />

    <TextView
        android:id="@+id/tvTituloDialogoAlerta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Comentario de Resolución"
        android:textColor="@color/cafe_profundo"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Por favor ingrese el motivo o detalle de la acción a registrar:"
        android:textColor="@color/color_texto_secundario"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etComentarioAlerta"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_search_box"
        android:gravity="top|start"
        android:hint="Ej. Se coordinó reposición con almacén central..."
        android:padding="12dp"
        android:textColor="#333333"
        android:textSize="14sp"
        android:inputType="textMultiLine|textLongMessage"
        android:autofillHints="comment"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarAlertaDialog"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Cancelar"
            android:textColor="#757575"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarAlertaDialog"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Confirmar"
            app:backgroundTint="@color/chocolate"
            android:textColor="@android:color/white"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>