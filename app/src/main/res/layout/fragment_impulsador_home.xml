<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dashboard Impulsador"
        android:textColor="@color/color_texto"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Tarjeta Dashboard Local -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ubicación Actual"
                android:textColor="@color/color_texto_secundario"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvLocalAsignado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buscando asignación..."
                android:textColor="@color/color_texto"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvHorario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Horario: ---"
                android:textColor="@color/color_texto_secundario"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginVertical="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Meta del Día -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meta del Día"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMetaVentas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/color_texto"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Ventas Reales -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avance"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvAvanceVentas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/chocolate"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbVentasImpulsador"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/chocolate" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botón Escanear Producto -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEscanear"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:text="Escanear Producto"
        app:icon="@drawable/ic_camera_icon"
        app:iconTint="@color/white"
        app:iconSize="28dp"
        app:iconGravity="textStart"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/chocolate"
        android:textColor="@color/white"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/cardDashboard" />

    <!-- Botón Reportar Incidencia -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReportarIncidencia"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="Reportar Incidencia"
        app:icon="@drawable/ic_warning_alert"
        app:iconSize="24dp"
        app:iconTint="@color/color_acento"
        app:iconGravity="textStart"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:strokeColor="@color/color_acento"
        android:textColor="@color/color_texto"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnEscanear" />

</androidx.constraintlayout.widget.ConstraintLayout>