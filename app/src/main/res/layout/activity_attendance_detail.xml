<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 3: Detalle de Asistencia (activity_attendance_detail.xml) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/attendanceDetailRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema_vainilla"
    tools:context=".AttendanceDetailActivity">

    <!-- Header Toolbar con Botón Volver -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_normal"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/title_detalle_asistencia"
            android:textAppearance="@style/TextAppearance.Piccoli.ToolbarTitle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ScrollView de Contenido -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_large">

            <!-- Card Superior: "Marcar Entrada/Salida" -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAttendanceHeader"
                style="@style/Widget.Piccoli.Card.Marfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_normal"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Banner Oscuro Superior -->
                    <TextView
                        android:id="@+id/tvAttendanceBannerTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/cafe_profundo"
                        android:gravity="center"
                        android:paddingVertical="@dimen/spacing_medium"
                        android:text="@string/label_marcar_entrada_salida"
                        android:textAppearance="@style/TextAppearance.Piccoli.CardTitle"
                        android:textColor="@color/marfil_suave" />

                    <!-- Detalles del Estado de Asistencia -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/spacing_normal">

                        <!-- Ícono Check Verde -->
                        <ImageView
                            android:id="@+id/ivCheckStatus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@string/cd_check_icon"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_check_circle_green" />

                        <!-- Título del Estado (BD: registro_asistencia.tipo_registro -> "Entrada registrada") -->
                        <TextView
                            android:id="@+id/tvStatusTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_medium"
                            android:textAppearance="@style/TextAppearance.Piccoli.BodyPrimary"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/ivCheckStatus"
                            app:layout_constraintTop_toTopOf="@+id/ivCheckStatus"
                            tools:text="Entrada registrada" />

                        <!-- Hora (BD: registro_asistencia.hora) -->
                        <TextView
                            android:id="@+id/tvAttendanceTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Piccoli.BodySecondary"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/tvStatusTitle"
                            app:layout_constraintTop_toBottomOf="@+id/tvStatusTitle"
                            tools:text="08:00 a.m." />

                        <!-- Ícono Ubicación -->
                        <ImageView
                            android:id="@+id/ivLocationIconHeader"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:contentDescription="@string/cd_location_icon"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/ivCheckStatus"
                            app:srcCompat="@drawable/ic_location_pin"
                            app:tint="@color/chocolate" />

                        <!-- Nombre de Ubicación / Sede (BD: sede.nombre_direccion) -->
                        <TextView
                            android:id="@+id/tvAttendanceLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:textAppearance="@style/TextAppearance.Piccoli.BodySecondary"
                            app:layout_constraintBottom_toBottomOf="@+id/ivLocationIconHeader"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/ivLocationIconHeader"
                            app:layout_constraintTop_toTopOf="@+id/ivLocationIconHeader"
                            tools:text="Plaza Vea - Los Olivos" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- MapView Pequeño con Marker -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMiniMapPreview"
                style="@style/Widget.Piccoli.Card.Marfil"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mini_map_height"
                android:layout_marginHorizontal="@dimen/spacing_normal"
                android:layout_marginBottom="@dimen/spacing_medium">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Mapa interactivo / vista previa -->
                    <com.google.android.gms.maps.MapView
                        android:id="@+id/miniMapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Pin de Mapa Simulado sobre el MapView -->
                    <ImageView
                        android:id="@+id/ivMiniMapPin"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@null"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_location_pin"
                        app:tint="@color/cafe_profundo" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Sección: "Evidencia" -->
            <TextView
                android:id="@+id/tvEvidenceHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_normal"
                android:layout_marginBottom="@dimen/spacing_small"
                android:text="@string/label_evidencia"
                android:textAppearance="@style/TextAppearance.Piccoli.SectionHeader" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEvidenceContainer"
                style="@style/Widget.Piccoli.Card.Marfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_normal"
                android:layout_marginBottom="@dimen/spacing_medium">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_small">

                    <!-- Imagen de la Evidencia (BD: evidencia.foto_url) -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivEvidencePhoto"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/evidence_photo_height"
                        android:scaleType="centerCrop"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Piccoli.Rounded"
                        app:srcCompat="@drawable/fondopicolli" />

                    <!-- Botón/Ícono Flotante de Cámara -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCameraBadge"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="@dimen/spacing_small"
                        android:layout_marginBottom="@dimen/spacing_small"
                        app:cardBackgroundColor="@color/cafe_profundo"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:layout_constraintBottom_toBottomOf="@+id/ivEvidencePhoto"
                        app:layout_constraintEnd_toEndOf="@+id/ivEvidencePhoto">

                        <ImageView
                            android:id="@+id/ivCameraIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_camera"
                            app:srcCompat="@drawable/ic_camera_icon" />

                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card de Usuario / Colaborador -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUserInfo"
                style="@style/Widget.Piccoli.Card.Marfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_normal"
                android:layout_marginBottom="@dimen/spacing_medium">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_medium">

                    <!-- Foto Circular (BD: colaborador.foto_url) -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivUserPhoto"
                        android:layout_width="@dimen/avatar_size_large"
                        android:layout_height="@dimen/avatar_size_large"
                        android:contentDescription="@string/cd_user_avatar"
                        android:scaleType="centerCrop"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Piccoli.Circular"
                        app:srcCompat="@drawable/ic_avatar_placeholder" />

                    <!-- Nombre del Colaborador (BD: colaborador.nombre) -->
                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:textAppearance="@style/TextAppearance.Piccoli.CardTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivUserPhoto"
                        app:layout_constraintTop_toTopOf="@+id/ivUserPhoto"
                        tools:text="Luis Rojas" />

                    <!-- Ícono de Ubicación -->
                    <ImageView
                        android:id="@+id/ivUserLocationIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="6dp"
                        android:contentDescription="@string/cd_location_icon"
                        app:layout_constraintStart_toStartOf="@+id/tvUserName"
                        app:layout_constraintTop_toBottomOf="@+id/tvUserName"
                        app:srcCompat="@drawable/ic_location_pin"
                        app:tint="@color/chocolate" />

                    <!-- Ubicación (BD: colaborador.sede_actual) -->
                    <TextView
                        android:id="@+id/tvUserLocation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textAppearance="@style/TextAppearance.Piccoli.BodySecondary"
                        app:layout_constraintBottom_toBottomOf="@+id/ivUserLocationIcon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivUserLocationIcon"
                        app:layout_constraintTop_toTopOf="@+id/ivUserLocationIcon"
                        tools:text="Plaza Vea - Los Olivos" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Sección: "Historial de Turnos" -->
            <TextView
                android:id="@+id/tvShiftHistoryHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_normal"
                android:layout_marginBottom="@dimen/spacing_small"
                android:text="@string/label_historial_turnos"
                android:textAppearance="@style/TextAppearance.Piccoli.SectionHeader" />

            <!-- Empty State Historial de Turnos -->
            <LinearLayout
                android:id="@+id/layoutEmptyShiftState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_shift_history"
                    android:textAppearance="@style/TextAppearance.Piccoli.BodySecondary" />

            </LinearLayout>

            <!-- RecyclerView Historial de Turnos -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvShiftHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="2"
                tools:listitem="@layout/item_shift_history" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Botones de Acción al Final: "Justificar" y "Confirmar" -->
    <LinearLayout
        android:id="@+id/layoutBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/crema_vainilla"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_normal"
        android:paddingVertical="@dimen/spacing_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Botón Justificar (Outlined) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJustify"
            style="@style/Widget.Piccoli.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="@dimen/spacing_small"
            android:layout_weight="1"
            android:text="@string/btn_justificar" />

        <!-- Botón Confirmar (Relleno) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            style="@style/Widget.Piccoli.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1"
            android:text="@string/btn_confirmar" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
