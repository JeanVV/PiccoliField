<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E0E0"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_puntos_venta"
                app:tint="@color/chocolate"
                android:contentDescription="Icono Local" />

            <TextView
                android:id="@+id/tvNombrePuntoVenta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Metro San Isidro"
                android:textColor="@color/cafe_profundo"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBadgeEstadoAsignacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTUAL"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_badge_on_time"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvFechasAsignacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Desde: 2026-01-01 - Presente"
            android:textColor="#757575"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvMotivoAsignacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Motivo: Asignación Inicial"
            android:textColor="#424242"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvRegistradoPor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Registrado por: Admin Principal"
            android:textColor="#9E9E9E"
            android:textSize="11sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>