<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/marfil_suave"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Drag handle -->
        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_search_rounded"
            android:backgroundTint="#D9C09A" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Detalle del Prospecto"
                android:textColor="@color/cafe_profundo"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCerrarDetalleProspecto"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_search_rounded"
                android:backgroundTint="#F3E4C7"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/cafe_profundo"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbDetalleProspecto"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/cafe_profundo"
            android:visibility="gone" />

        <!-- Foto de fachada -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#F5E4CA"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E8D8C2"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivDetalleProspectoFoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="46dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_store"
                app:tint="@color/cafe_profundo" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Nombre y badges -->
        <TextView
            android:id="@+id/tvDetalleProspectoNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Nombre del Negocio"
            android:textColor="@color/cafe_profundo"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDetalleProspectoEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search_rounded"
                android:backgroundTint="#FFF3E0"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="NUEVO"
                android:textColor="#E65100"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalleProspectoPotencial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_search_rounded"
                android:backgroundTint="#F3E4C7"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Potencial: MEDIO"
                android:textColor="@color/cafe_profundo"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalleProspectoTipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Bodega"
                android:textColor="@color/chocolate"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Tarjeta de información -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E8D8C2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Información del Prospecto"
                    android:textColor="@color/cafe_profundo"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetalleProspectoDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Dirección: -"
                    android:textColor="@color/chocolate"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDetalleProspectoZona"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Distrito / Zona: -"
                    android:textColor="@color/chocolate"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDetalleProspectoContacto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Contacto: -"
                    android:textColor="@color/chocolate"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDetalleProspectoTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Teléfono: -"
                    android:textColor="@color/chocolate"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDetalleProspectoCoordenadas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Coordenadas: -"
                    android:textColor="@color/color_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDetalleProspectoNotas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Notas: -"
                    android:textColor="@color/chocolate"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvDetalleProspectoMotivoDescarte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Motivo de descarte: -"
                    android:textColor="#C62828"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta para cambiar estado -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E8D8C2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cambiar Estado"
                    android:textColor="@color/cafe_profundo"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProspectoConvertidoInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_search_rounded"
                    android:backgroundTint="#E8F5E9"
                    android:padding="10dp"
                    android:text="Este prospecto ya fue convertido a Punto de Venta y Distribución."
                    android:textColor="#2E7D32"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <RadioGroup
                    android:id="@+id/rgEstadoProspecto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbEstadoNuevo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cafe_profundo"
                        android:text="NUEVO"
                        android:textColor="@color/cafe_profundo"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbEstadoNegociacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cafe_profundo"
                        android:text="EN NEGOCIACIÓN"
                        android:textColor="@color/cafe_profundo"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbEstadoConvertido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cafe_profundo"
                        android:text="CONVERTIDO (Pasa a Punto de Distribución)"
                        android:textColor="#2E7D32"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbEstadoDescartado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cafe_profundo"
                        android:text="DESCARTADO"
                        android:textColor="#C62828"
                        android:textSize="14sp" />
                </RadioGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActualizarEstadoProspecto"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/cafe_profundo"
                    android:text="Actualizar Estado"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
