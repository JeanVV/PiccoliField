<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    tools:context="com.piccolifield.ui.supervisionPdv.SupervisionFragment">

    <!-- ScrollView para el contenido principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:padding="20dp">

            <!-- Cabecera -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvHeaderTitleSupervision"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/label_titulo_Supervision"
                    android:textColor="@color/color_texto"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- ======================================================== -->
            <!-- 1. CONTROLES EXCLUSIVOS PARA IMPULSADOR -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/layoutImpulsador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Tarjeta Dashboard Local -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDashboardImpulsador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubicación Actual"
                            android:textColor="@color/color_texto_secundario"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvLocalAsignado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Buscando asignación..."
                            android:textColor="@color/color_texto"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvHorario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Horario: ---"
                            android:textColor="@color/color_texto_secundario"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EEEEEE"
                            android:layout_marginVertical="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false"
                            android:weightSum="2">

                            <!-- Meta del Día -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Meta del Día"
                                    android:textColor="@color/color_texto_secundario"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvMetaVentas"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="S/ 0.00"
                                    android:textColor="@color/color_texto"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Ventas Reales -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Avance"
                                    android:textColor="@color/color_texto_secundario"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvAvanceVentas"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="S/ 0.00"
                                    android:textColor="@color/chocolate"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/pbVentasImpulsador"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="16dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="@color/chocolate" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Botón Escanear Producto -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEscanear"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Escanear Producto"
                    app:icon="@drawable/ic_camera_icon"
                    app:iconSize="28dp"
                    app:iconGravity="textStart"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:backgroundTint="@color/chocolate"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="16dp" />

                <!-- Botón Reportar Incidencia -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReportarIncidencia"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Reportar Incidencia"
                    app:icon="@drawable/ic_warning_alert"
                    app:iconSize="24dp"
                    app:iconTint="@color/color_acento"
                    app:iconGravity="textStart"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/color_acento"
                    android:textColor="@color/color_texto"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>

            <!-- ======================================================== -->
            <!-- 2. CONTROLES EXCLUSIVOS PARA SUPERVISOR / ADMIN -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/layoutSupervisor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Buscador -->
                <EditText
                    android:id="@+id/etBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_search_rounded"
                    android:drawableStart="@drawable/ic_search"
                    android:drawableTint="@color/chocolate"
                    android:drawablePadding="12dp"
                    android:hint="@string/hint_buscar_impulsador"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/color_texto_secundario"
                    android:textColorHint="@color/color_texto_secundario"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/tvTabInicio"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:paddingHorizontal="24dp"
                        android:text="@string/nav_inicio"
                        android:textColor="@color/black"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTabPuntos"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="16dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="@string/btn_pdv"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tvTabAlertas"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="16dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="@string/btn_alerta"
                        android:textColor="@color/black" />
                </LinearLayout>

                <!-- Tarjeta Total Ventas -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    app:cardBackgroundColor="@color/chocolate"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="16dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <TextView
                            android:id="@+id/tvTotalVentasLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_monto_total"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_margin="20dp"/>

                        <TextView
                            android:id="@+id/tvTotalVentasValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/datos_vacios"
                            android:textColor="@color/white"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="@+id/tvTotalVentasLabel"
                            app:layout_constraintTop_toBottomOf="@+id/tvTotalVentasLabel"
                            android:layout_marginTop="4dp"/>

                        <ImageView
                            android:layout_width="150dp"
                            android:layout_height="0dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/grafico_barras"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tarjetas Pequeñas (Puntos Activos y Alertas) -->
                <LinearLayout
                    android:id="@+id/layoutDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginBottom="24dp">

                    <!-- Puntos Activos -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@color/crema_vainilla"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp">
                            <TextView
                                android:id="@+id/tvPuntosLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_pdv_activos"
                                android:textColor="@color/black"
                                android:textSize="12sp"/>
                            <TextView
                                android:id="@+id/tvPdvActivos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/tvPuntosLabel"
                                android:layout_marginTop="8dp"
                                android:text="@string/datos_vacios"
                                android:textColor="@color/black"
                                android:textSize="24sp"
                                android:textStyle="bold"/>
                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentBottom="true"
                                app:tint="@color/chocolate"/>
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Alertas de Stock -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="@color/crema_vainilla"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp">
                            <TextView
                                android:id="@+id/tvAlertasLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_alertas"
                                android:textColor="@color/black"
                                android:textSize="12sp"/>
                            <TextView
                                android:id="@+id/tvAlertasPendientes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/tvAlertasLabel"
                                android:layout_marginTop="8dp"
                                android:text="@string/datos_vacios"
                                android:textColor="@color/black"
                                android:textSize="24sp"
                                android:textStyle="bold"/>
                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentBottom="true"
                                android:src="@drawable/warning_24px"
                                app:tint="@color/color_acento"/>
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Título de Lista -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvTituloLista"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_mejores_impulsadores"
                        android:textColor="@color/color_texto"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <ProgressBar
                    android:id="@+id/pbLoadingListas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone" />

                <!-- Lista de Vendedores -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvVendedores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_vendedor"
                    tools:itemCount="4"/>

                <!-- Lista de Puntos de Venta -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPuntosVenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    tools:listitem="@layout/item_supervision_puntoventa"
                    tools:itemCount="4"/>

                <!-- Lista de Alertas -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAlertas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    tools:listitem="@layout/item_alerta"
                    tools:itemCount="4"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>