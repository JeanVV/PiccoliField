<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#E8D8C2"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <!-- Foto miniatura -->
        <ImageView
            android:id="@+id/ivFotoItemSeleccionado"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_search_rounded"
            android:backgroundTint="#F8EFE0"
            android:contentDescription="@null"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/botellasinicio" />

        <!-- Nombre y Precio unitario -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreItemSeleccionado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Piccoli Café"
                android:textColor="@color/cafe_profundo"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPrecioUnitarioItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/ 18.00"
                android:textColor="@color/chocolate"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Controles de cantidad en pill (- 1 +) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_rounded"
            android:backgroundTint="#F8EFE0"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenosItemLista"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="-"
                android:textColor="@color/cafe_profundo"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCantidadItemLista"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/cafe_profundo"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMasItemLista"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/cafe_profundo"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subtotal y Quitar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSubtotalItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/ 18.00"
                android:textColor="@color/cafe_profundo"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQuitarItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp"
                android:text="Quitar"
                android:textColor="#C0392B"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
