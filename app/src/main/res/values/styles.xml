<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ESTILOS DE TEXTO -->
    <style name="TextAppearance.Piccoli.ToolbarTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textColor">@color/cafe_profundo</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Piccoli.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textColor">@color/cafe_profundo</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Piccoli.CardTitle" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textColor">@color/cafe_profundo</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Piccoli.BodyPrimary" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/cafe_profundo</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Piccoli.BodySecondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_size_body_small</item>
        <item name="android:textColor">@color/chocolate</item>
    </style>

    <style name="TextAppearance.Piccoli.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textColor">@color/color_text_muted</item>
    </style>

    <style name="TextAppearance.Piccoli.DisplayNumber" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textSize">@dimen/text_size_display</item>
        <item name="android:textColor">@color/cafe_profundo</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Piccoli.Badge" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ESTILOS DE CARDS -->
    <style name="Widget.Piccoli.Card.Primary" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/beige_licor</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Piccoli.Card.Marfil" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/marfil_suave</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/stroke_color</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ESTILOS DE BOTONES -->
    <style name="Widget.Piccoli.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/cafe_profundo</item>
        <item name="android:textColor">@color/marfil_suave</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Piccoli.Button.Accent" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/dorado_premium</item>
        <item name="android:textColor">@color/cafe_profundo</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Piccoli.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/cafe_profundo</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/cafe_profundo</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- FORMAS PARA SHAPEABLE IMAGE VIEW -->
    <style name="ShapeAppearance.Piccoli.Circular" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Piccoli.Rounded" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Piccoli.TopRounded" parent="">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
